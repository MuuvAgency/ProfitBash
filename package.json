{
  "name": "profitbash",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @profitbash/db run generate",
    "db:migrate": "pnpm --filter @profitbash/db run migrate",
    "db:seed": "pnpm --filter @profitbash/api run seed",
    "demo:load": "pnpm --filter @profitbash/worker run demo:load",
    "db:rotate-keys": "pnpm --filter @profitbash/db run rotate-keys",
    "api:generate": "pnpm --filter @profitbash/api run openapi && pnpm --filter @profitbash/web run api:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}

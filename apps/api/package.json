{
  "name": "@profitbash/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono-API (liefert in Prod auch das Web aus)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "auth:schema": "auth generate --config src/auth-cli.ts --output ../../packages/db/src/schema/auth.ts --yes && prettier --write ../../packages/db/src/schema/auth.ts",
    "seed": "tsx src/seed-cli.ts",
    "openapi": "tsx src/openapi-cli.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.5",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@profitbash/amazon-ads": "workspace:*",
    "@profitbash/db": "workspace:*",
    "@profitbash/engine": "workspace:*",
    "@profitbash/shared": "workspace:*",
    "@profitbash/worker": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pg-boss": "^12.34.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@profitbash/sheets": "workspace:*",
    "auth": "1.7.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
